rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Suggestion rate limit: 5 per hour per participant, counter in participants/{uid}.
    function suggestionWindowActive(p) {
      return 'suggestionWindowStart' in p && request.time < p.suggestionWindowStart + duration.value(1, 'h');
    }

    function suggestionAllowed(p) {
      return !suggestionWindowActive(p) || p.suggestionCount < 5;
    }

    function roomParticipants() {
      return resource.data.participants;
    }

    function roomDoc(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId));
    }

    function roomExists(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId));
    }

    function userInRoom(roomId, uid) {
      return roomExists(roomId) && uid in roomDoc(roomId).data.participants;
    }

    function isCreator() {
      return request.auth.uid == resource.data.creatorUid;
    }

    function isValidSessionStatus(value) {
      return value == 'active' || value == 'completed' || value == 'expired';
    }

    function isValidSearchRadius(value) {
      return value == null || (value is int && value >= 200 && value <= 3000);
    }

    function isValidMeetingFormat(value) {
      return value == null
             || value == 'food'
             || value == 'culture'
             || value == 'walk_only'
             || value == 'active'
             // Legacy values kept for backward compatibility.
             || value == 'coffee'
             || value == 'dinner'
             || value == 'walk_and_coffee';
    }

    function isValidMeetingFormatList(values) {
      return values is list
             && values.size() <= 8
             && values.hasOnly([
               'food',
               'culture',
               'walk_only',
               'active',
               // Legacy values kept for backward compatibility.
               'coffee',
               'dinner',
               'walk_and_coffee'
             ]);
    }

    function isValidMeetingSnapshot(snapshot) {
      return snapshot == null
             || (
               (snapshot.center == null
                || (
                  snapshot.center.lat is number
                  && snapshot.center.lng is number
                  && snapshot.center.lat >= -90
                  && snapshot.center.lat <= 90
                  && snapshot.center.lng >= -180
                  && snapshot.center.lng <= 180
                ))
               && isValidSearchRadius(snapshot.searchRadius)
             );
    }

    function unchanged(field) {
      return !(field in request.resource.data)
             || request.resource.data[field] == resource.data[field];
    }

    function creatorIdentityUnchanged() {
      return request.resource.data.creatorUid == resource.data.creatorUid
             && unchanged('createdBy')
             && unchanged('hostUid')
             && unchanged('type')
             && unchanged('visibility')
             && unchanged('capacity')
             && unchanged('participants')
             && unchanged('participantCount');
    }

    function isValidCapacity(value) {
      return value is int && value >= 2 && value <= 20;
    }

    // Open room: a new member joins through one transaction that appends
    // exactly one uid and respects capacity. Nothing else may change.
    function isOpenJoinUpdate() {
      return resource.data.type == 'open'
             && resource.data.sessionStatus == 'active'
             && !(request.auth.uid in resource.data.participants)
             && request.resource.data.participants.size() == resource.data.participants.size() + 1
             && request.auth.uid in request.resource.data.participants
             && resource.data.participants.size() < resource.data.capacity
             && resource.data.expiresAt > request.time
             && request.resource.data.capacity == resource.data.capacity
             && request.resource.data.type == 'open'
             && request.resource.data.creatorUid == resource.data.creatorUid
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'participantCount', 'updatedAt']);
    }

    // Open room: a non-host member leaves through one transaction that removes
    // exactly its own uid and decrements participantCount. Host cannot use this path.
    function isOpenLeaveUpdate() {
      return resource.data.type == 'open'
             && request.auth.uid in resource.data.participants
             && (request.auth.uid != resource.data.creatorUid || resource.data.sessionStatus != 'active')
             && !(request.auth.uid in request.resource.data.participants)
             && request.resource.data.participants.size() == resource.data.participants.size() - 1
             && request.resource.data.participantCount == resource.data.participantCount - 1
             && request.resource.data.capacity == resource.data.capacity
             && request.resource.data.type == 'open'
             && request.resource.data.creatorUid == resource.data.creatorUid
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'participantCount', 'updatedAt']);
    }

    // Host leaves an active open room: ownership passes to participants[1] (the
    // earliest member, since the host is always participants[0]). One member less.
    function isOpenHostTransferUpdate() {
      return resource.data.type == 'open'
             && resource.data.sessionStatus == 'active'
             && request.auth.uid == resource.data.creatorUid
             && resource.data.participants.size() >= 2
             && request.resource.data.creatorUid == resource.data.participants[1]
             && request.resource.data.creatorUid != resource.data.creatorUid
             && !(request.auth.uid in request.resource.data.participants)
             && request.resource.data.participants.size() == resource.data.participants.size() - 1
             && request.resource.data.participantCount == resource.data.participantCount - 1
             && request.resource.data.capacity == resource.data.capacity
             && request.resource.data.type == 'open'
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'participantCount', 'creatorUid', 'createdBy', 'hostUid', 'updatedAt']);
    }

    // Host sets the next step (venue after the event) and the search radius.
    function isOpenPlanUpdate() {
      return resource.data.type == 'open'
             && resource.data.sessionStatus == 'active'
             && request.auth.uid == resource.data.creatorUid
             && request.resource.data.creatorUid == resource.data.creatorUid
             && (request.resource.data.nextStep == null || request.resource.data.nextStep is map)
             && (!('planRadiusMeters' in request.resource.data) || (request.resource.data.planRadiusMeters is int && request.resource.data.planRadiusMeters >= 300 && request.resource.data.planRadiusMeters <= 3000))
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nextStep', 'planRadiusMeters', 'updatedAt']);
    }

    // A participant persists expiry once the time is up (active -> expired).
    function isOpenExpireUpdate() {
      return resource.data.type == 'open'
             && resource.data.sessionStatus == 'active'
             && resource.data.expiresAt <= request.time
             && request.auth.uid in resource.data.participants
             && request.resource.data.sessionStatus == 'expired'
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sessionStatus', 'updatedAt']);
    }

    // Only the creator ends a session (active -> completed), touching nothing else.
    // Applies to private and open rooms; participants cannot change the status.
    function isCreatorCompleteUpdate() {
      return resource.data.sessionStatus == 'active'
             && request.auth.uid == resource.data.creatorUid
             && request.resource.data.sessionStatus == 'completed'
             && request.resource.data.creatorUid == resource.data.creatorUid
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sessionStatus', 'completedAt', 'completedBy', 'updatedAt']);
    }

    // Participants may only mutate their own address / format / radius fields.
    function roleScopedRoomFieldsOk() {
      return creatorIdentityUnchanged()
             && unchanged('sessionStatus')
             && unchanged('completedAt')
             && unchanged('completedBy')
             && unchanged('nextStep')
             && unchanged('planRadiusMeters')
             && (
               isCreator()
                 ? unchanged('point2')
                   && unchanged('partnerMeetingFormats')
                   && unchanged('partnerMeetingFormat')
                   && unchanged('partnerSelectedMeetingFormat')
                   && unchanged('partnerSearchRadius')
                   && unchanged('partnerSearchRadiusUpdatedAt')
                   && unchanged('partnerUid')
                 : unchanged('point1')
                   && unchanged('creatorMeetingFormats')
                   && unchanged('creatorMeetingFormat')
                   && unchanged('creatorSelectedMeetingFormat')
                   && unchanged('creatorSearchRadius')
                   && unchanged('creatorSearchRadiusUpdatedAt')
             )
             && (
               !('creatorMeetingFormats' in request.resource.data)
               || isValidMeetingFormatList(request.resource.data.creatorMeetingFormats)
             )
             && (
               !('partnerMeetingFormats' in request.resource.data)
               || isValidMeetingFormatList(request.resource.data.partnerMeetingFormats)
             )
             && (
               !('creatorSelectedMeetingFormat' in request.resource.data)
               || isValidMeetingFormat(request.resource.data.creatorSelectedMeetingFormat)
             )
             && (
               !('partnerSelectedMeetingFormat' in request.resource.data)
               || isValidMeetingFormat(request.resource.data.partnerSelectedMeetingFormat)
             )
             && (
               !('selectedMeetingFormat' in request.resource.data)
               || isValidMeetingFormat(request.resource.data.selectedMeetingFormat)
             )
             && (
               !('meetingSnapshot' in request.resource.data)
               || isValidMeetingSnapshot(request.resource.data.meetingSnapshot)
             )
             && (
               !('sessionStatus' in request.resource.data)
               || isValidSessionStatus(request.resource.data.sessionStatus)
             );
    }

    function isJoinUpdate() {
      return (!('type' in resource.data) || resource.data.type != 'open')
             && resource.data.partnerUid == null
             && request.resource.data.partnerUid == request.auth.uid
             && request.resource.data.creatorUid == resource.data.creatorUid
             && request.resource.data.participants.size() == 2
             && request.auth.uid in request.resource.data.participants
             && resource.data.creatorUid in request.resource.data.participants
             && unchanged('point1')
             && unchanged('creatorMeetingFormats')
             && unchanged('creatorSelectedMeetingFormat')
             && unchanged('creatorSearchRadius');
    }

    // Legacy root-level history is not used by the app.
    // Keep a single source of truth: /users/{uid}/meeting_history.
    match /meeting_history/{docId} {
      allow read, write: if false;
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn();

      // Keep create permissive for authenticated creator to avoid schema drift lockouts.
      allow create: if isSignedIn()
                    && request.resource.data.creatorUid == request.auth.uid
                    && (!('capacity' in request.resource.data) || isValidCapacity(request.resource.data.capacity));

      allow update: if isSignedIn()
                    && (
                      (
                        request.auth.uid in roomParticipants()
                        && roleScopedRoomFieldsOk()
                      )
                      || isJoinUpdate()
                      || isOpenJoinUpdate()
                      || isOpenLeaveUpdate()
                      || isCreatorCompleteUpdate()
                      || isOpenHostTransferUpdate()
                      || isOpenExpireUpdate()
                      || isOpenPlanUpdate()
                    );

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
                    && request.auth.uid in roomDoc(roomId).data.participants;
        allow create: if isSignedIn()
                      && request.auth.uid in roomDoc(roomId).data.participants
                      && (
                        request.resource.data.kind == 'system'
                        || (
                          roomDoc(roomId).data.get('sessionStatus', 'active') == 'active'
                          && (
                            roomDoc(roomId).data.get('type', 'private') != 'open'
                            || roomDoc(roomId).data.expiresAt > request.time
                          )
                        )
                      )
                      && request.resource.data.senderUid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() >= 1
                      && request.resource.data.text.size() <= 2000
                      && request.resource.data.kind in ['text', 'system']
                      && request.resource.data.clientId is string
                      && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /reads/{uid} {
        allow read: if isSignedIn()
                    && request.auth.uid in roomDoc(roomId).data.participants;
        allow write: if isSelf(uid)
                      && request.auth.uid in roomDoc(roomId).data.participants;
      }

      // Participant docs: each user writes only their own doc.
      // Host doc is created with the room; members join an open room only.
      // Place suggestions for the open-session plan (design 11.2).
      // Any participant proposes (rate limited via participants/{uid} counter);
      // only the host changes status. Suggestions are never deleted.
      match /suggestions/{suggestionId} {
        allow read: if isSignedIn()
                    && request.auth.uid in roomDoc(roomId).data.participants;
        allow create: if isSignedIn()
                      && roomDoc(roomId).data.type == 'open'
                      && roomDoc(roomId).data.sessionStatus == 'active'
                      && roomDoc(roomId).data.expiresAt > request.time
                      && request.auth.uid in roomDoc(roomId).data.participants
                      && request.resource.data.proposedBy == request.auth.uid
                      && request.resource.data.status == 'suggested'
                      && request.resource.data.placeName is string
                      && request.resource.data.placeName.size() >= 1
                      && request.resource.data.placeName.size() <= 120
                      && (request.resource.data.placeAddress == null || (request.resource.data.placeAddress is string && request.resource.data.placeAddress.size() <= 200))
                      && request.resource.data.lat is number
                      && request.resource.data.lon is number
                      && request.resource.data.keys().hasOnly(['placeName', 'placeAddress', 'placeType', 'lat', 'lon', 'proposedBy', 'status', 'createdAt'])
                      && suggestionAllowed(get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid)).data);
        allow update: if isSignedIn()
                      && roomDoc(roomId).data.creatorUid == request.auth.uid
                      && roomDoc(roomId).data.sessionStatus == 'active'
                      && request.resource.data.status in ['suggested', 'chosen', 'rejected']
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'chosenAt']);
        allow delete: if false;
      }

      match /participants/{uid} {
        allow read: if isSignedIn();
        allow create: if isSelf(uid)
                      && (
                        (
                          request.resource.data.role == 'host'
                          && (!roomExists(roomId) || roomDoc(roomId).data.creatorUid == uid)
                        )
                        || (
                          request.resource.data.role == 'member'
                          && roomExists(roomId)
                          && ('type' in roomDoc(roomId).data) && roomDoc(roomId).data.type == 'open'
                        )
                      );
        allow update: if isSelf(uid)
                      && roomExists(roomId)
                      && request.auth.uid in roomDoc(roomId).data.participants
                      && (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'point',
                          'searchRadius',
                          'meetingFormats',
                          'meetingFormat',
                          'selectedMeetingFormat',
                          'lastReadAt',
                          'updatedAt'
                        ])
                        || (
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suggestionWindowStart', 'suggestionCount', 'updatedAt'])
                          && (
                            // Window still running: same start, exactly one more suggestion, max 5.
                            (suggestionWindowActive(resource.data)
                              && request.resource.data.suggestionWindowStart == resource.data.suggestionWindowStart
                              && request.resource.data.suggestionCount == resource.data.suggestionCount + 1
                              && request.resource.data.suggestionCount <= 5)
                            // Window expired (or first suggestion): start a new window with count 1.
                            || (!suggestionWindowActive(resource.data)
                              && request.resource.data.suggestionWindowStart == request.time
                              && request.resource.data.suggestionCount == 1)
                          )
                        )
                      );
        // Member docs exist only in open rooms (create requires type == 'open'),
        // so deleting one's own member doc is the leave path. Host doc stays.
        // Host doc may be removed only after the session ended (host transfer comes later).
        allow delete: if isSelf(uid)
                      && (
                        resource.data.role == 'member'
                        || (resource.data.role == 'host'
                            && roomExists(roomId)
                            && (
                              roomDoc(roomId).data.get('sessionStatus', 'active') != 'active'
                              || roomDoc(roomId).data.creatorUid == uid
                            ))
                      );
      }
    }

    match /roomInvites/{inviteCode} {
      allow read: if isSignedIn();
      // Creator may mint/refresh invites that point at their room.
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.roomId is string
                    && request.resource.data.expiresAt is timestamp;
      allow update: if isSignedIn()
                    && resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.roomId == resource.data.roomId;
      allow delete: if false;
    }

    // Public profile (design 10.2): read by any signed-in user, write by owner only.
    match /publicProfiles/{uid} {
      allow read: if isSignedIn();
      allow write: if isSelf(uid)
                   && request.resource.data.keys().hasOnly(['displayName', 'googleName', 'photoUrl', 'avatarBase64', 'avatarPreset', 'updatedAt'])
                   && (!('displayName' in request.resource.data) || request.resource.data.displayName == null || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 40))
                   && (!('avatarBase64' in request.resource.data) || request.resource.data.avatarBase64 == null || (request.resource.data.avatarBase64 is string && request.resource.data.avatarBase64.size() <= 45000))
                   && (!('avatarPreset' in request.resource.data) || request.resource.data.avatarPreset == null || (request.resource.data.avatarPreset is int && request.resource.data.avatarPreset >= 0 && request.resource.data.avatarPreset <= 11));
    }

    match /users/{uid} {
      allow read, write: if isSelf(uid);

      match /favorites/{docId} {
        allow read, write: if isSelf(uid);
      }

      match /meeting_history/{docId} {
        allow read: if isSelf(uid);

        // Allow creating history for both participants on proposal accept.
        allow create: if isSelf(uid)
                      || (
                        isSignedIn()
                        && request.resource.data.roomId is string
                        && userInRoom(request.resource.data.roomId, request.auth.uid)
                        && userInRoom(request.resource.data.roomId, uid)
                      );

        // Only owner can edit/delete own history entries.
        allow update, delete: if isSelf(uid);
      }

      match /address_memory/{docId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
                              && request.resource.data.address is string
                              && request.resource.data.address.size() > 2
                              && request.resource.data.usesCount is int
                              && request.resource.data.usesCount >= 1;
        allow delete: if isSelf(uid);
      }
    }
  }
}
